<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- sync-watch: watchdog for the laptop's scheduled-job estate. Daily 09:30
     (after the 7:00/9:00/9:15 morning jobs). Alerts Discord ONLY on problems.
     Source of truth: heartbeat repo etc/laptop/. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.sync-watch</string>
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>/Users/chandlerhardy/bin/sync-watch.sh</string></array>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <key>RunAtLoad</key><false/>
    <key>StandardOutPath</key><string>/Users/chandlerhardy/heartbeat-reports/sync-watch-agent.log</string>
    <key>StandardErrorPath</key><string>/Users/chandlerhardy/heartbeat-reports/sync-watch-agent.err</string>
</dict>
</plist>
