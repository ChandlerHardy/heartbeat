<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Monday standup notes (mini launchd agent). Migrated from the OCI cron on
  2026-09-08 -- the mini already holds the PLA `glab` token and a GUI-session
  Claude login, and it is where the rest of the PLA automation lives.

  Sunday 20:05 CT (the OCI slot was 01:05 UTC Monday = the same moment).
  `worksweep standup --discord`: classify the week's pushes, one claude -p
  pass for prose, validate, post; a collection failure is a 🔴, a model
  failure ships the deterministic fallback. Never silent.

  MUST be bootstrapped into the GUI domain (Keychain-held Claude credential):
    cp etc/mini/com.chandlerhardy.standup-notes.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.chandlerhardy.standup-notes.plist
  Run once now:
    launchctl kickstart gui/$(id -u)/com.chandlerhardy.standup-notes
  Preview without posting:
    bin/worksweep.sh standup --dry-run
  Logs: ~/heartbeat-reports/standup-notes.log / standup-notes.err
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chandlerhardy.standup-notes</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/chandlerhardy/repos/heartbeat/bin/worksweep.sh</string>
        <string>standup</string>
        <string>--discord</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/chandlerhardy/.pyenv/shims:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/chandlerhardy</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/chandlerhardy/heartbeat-reports/standup-notes.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/chandlerhardy/heartbeat-reports/standup-notes.err</string>
</dict>
</plist>
