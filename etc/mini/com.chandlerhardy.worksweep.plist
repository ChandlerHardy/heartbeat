<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Worksweep digest sweeps (mini launchd agent).

  Runs on the always-on Mac mini; no wake race, stable CT time.
  Worksweep needs the PLA `glab` auth and the local `.magi` tribunal reports.

  Install:
    cp etc/mini/com.chandlerhardy.worksweep.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.chandlerhardy.worksweep.plist
  Run once now (no waiting for 9 AM):
    launchctl start com.chandlerhardy.worksweep
  Uninstall:
    launchctl unload -w ~/Library/LaunchAgents/com.chandlerhardy.worksweep.plist
  Logs: ~/heartbeat-reports/worksweep.log (stdout) / worksweep.err (stderr)

  Sweeps run every 3 hours across the working day: 8am / 11am / 2pm / 5pm /
  8pm CT (2026-08-31: keep-current wants <=3h staleness against master while
  colleagues are merging; no overnight runs because the digest contract is
  never-silence and master does not move at 3am).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chandlerhardy.worksweep</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/chandlerhardy/repos/heartbeat/bin/worksweep.sh</string>
        <string>--discord</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>17</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <!-- launchd starts with a minimal PATH; include Homebrew (glab) and the
         pyenv shims (python3) so the script's tools resolve. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/chandlerhardy/.pyenv/shims:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/chandlerhardy</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/chandlerhardy/heartbeat-reports/worksweep.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/chandlerhardy/heartbeat-reports/worksweep.err</string>
</dict>
</plist>
